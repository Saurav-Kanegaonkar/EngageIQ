# Copy this file to `.env` and fill in your values. NEVER commit `.env`.

# GitHub — https://github.com/settings/tokens  (classic, NO scopes needed for public read)
GITHUB_TOKEN=

# Reddit — https://www.reddit.com/prefs/apps  (create a "script" app)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=EngageIQ/0.1 by u/your_reddit_username

# LLM for the 2-stage KNN->LLM re-rank + Suggested Actions + "Why this?".
# We use NVIDIA's FREE hosted API (build.nvidia.com). Leave blank for offline fallback.
NVIDIA_API_KEY=
OPENAI_API_KEY=

# Bluesky — public search now needs auth. Create a free APP PASSWORD:
# bsky.app -> Settings -> Privacy and Security -> App Passwords. Handle = e.g. name.bsky.social
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# No credentials required: GH Archive, Hacker News, Dev.to
